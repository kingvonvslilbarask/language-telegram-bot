# Copy to .env (never commit .env). In production set these as real environment variables.

# From @BotFather. Treat like a password. If it ever leaks, send /revoke to BotFather.
TELEGRAM_BOT_TOKEN=

# Public HTTPS address of THIS service (no trailing slash). On Render leave this empty: it is detected automatically.
WEBHOOK_BASE_URL=

# Random secrets - generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=     # Telegram sends this back in a header so we know a request is really from Telegram
INTERNAL_API_KEY=            # your web backend sends this in X-Api-Key when it calls the bot

# Admin Telegram chat IDs, comma separated. Each admin must open the bot, press Start,
# then send /id to learn their number.
ADMIN_CHAT_IDS=

# Our web backend (source of truth). Used for /start linking and /myclasses.
# The bot sends WEB_BACKEND_API_KEY in the X-Api-Key header. Leave both empty to disable.
WEB_BACKEND_URL=
WEB_BACKEND_API_KEY=

SCHOOL_NAME=Azela Language School
SCHOOL_TIMEZONE=Africa/Addis_Ababa

# Onboarding video: put your file at assets/guide.mp4 (H.264 mp4, under 50 MB) ...
GUIDE_VIDEO_PATH=assets/guide.mp4
# ... optionally set this after the first upload (the bot logs it) to skip re-uploading after restarts
GUIDE_VIDEO_FILE_ID=
# ... or a public https link to the video (Telegram downloads it; up to ~20 MB). Easiest on a free host.
GUIDE_VIDEO_URL=

HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
LEDGER_PATH=data/ledger.sqlite3

# ---- used ONLY by demo.py (for screen-share demos) ----
# Your own Telegram chat ID (press Start on the bot, then send /id). The demo sends everything to you.
DEMO_CHAT_ID=
# Optional: a second account's chat ID, so a "teacher" phone can receive the staff notifications
DEMO_TEACHER_CHAT_ID=
DEMO_STUDENT_NAME=Abebe Kebede
DEMO_TEACHER_NAME=Sarah Bekele
